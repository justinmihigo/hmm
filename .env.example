# EmailJS browser configuration. The public key is intentionally client-visible.
VITE_EMAILJS_PUBLIC_KEY=your-public-key
VITE_EMAILJS_SERVICE_ID=service_your-id
VITE_EMAILJS_TEMPLATE_ID=template_your-id

# Optional: add an owned 5–8 second muted loop to the Three.js hero sequence.
# Put optimized files in public/media/ or use absolute CDN URLs.
# VITE_HERO_VIDEO_WEBM=/media/honore-hero.webm
# VITE_HERO_VIDEO_MP4=/media/honore-hero.mp4
